{
	"name": "pi-file-links",
	"version": "0.1.0",
	"description": "Make relative file links in Pi's assistant replies clickable by resolving them to absolute file:// URLs.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jetemple/pi-file-links.git"
	},
	"homepage": "https://github.com/Jetemple/pi-file-links#readme",
	"bugs": "https://github.com/Jetemple/pi-file-links/issues",
	"keywords": [
		"pi-package",
		"pi-extension",
		"osc8",
		"hyperlinks",
		"terminal"
	],
	"files": [
		"extensions",
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/file-links.ts"
		]
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^22.0.0",
		"typescript": "^5.9.0"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
